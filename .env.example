# GEMINI_API_KEY: Required if Gemini AI features are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Application Database Mode:
#   auto  -> Uses MySQL Mode if valid credentials are set and reachable, else Demo Mode (default)
#   demo  -> Forces Demo Mode (synthetic sample data, zero MySQL dependency)
#   mysql -> Attempts MySQL Mode (falls back to Demo Mode if unreachable)
DB_MODE="auto"

# MySQL Database Credentials (for MySQL Mode on Windows / Production)
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="your_mysql_password"
DB_NAME="food_delivery_analytics"
PORT="3000"
